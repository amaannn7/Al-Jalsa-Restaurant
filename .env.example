# Postgres connection (Neon on Vercel sets DATABASE_URL and DATABASE_URL_UNPOOLED automatically)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL_UNPOOLED=""
# Long random string used to sign admin sessions: openssl rand -base64 48
AUTH_SECRET=""
# First admin account, created by the seed if no admin exists yet
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Vercel Blob token for admin image uploads (created automatically when you add a Blob store)
BLOB_READ_WRITE_TOKEN=""
# Public site URL, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
# Keep "false" on previews/staging; set "true" on the live domain to allow search indexing
NEXT_PUBLIC_ALLOW_INDEXING="false"
